  <diagram id="latest-inputs" name="05 - Latest Answer Inputs">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Latest answered inputs — architecture and delivery gates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c74634;strokeColor=#c74634;strokeWidth=2;fontColor=#312d2a;fontSize=24;align=left;verticalAlign=top;spacing=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Scope &amp; delivery&lt;/b&gt;&lt;br&gt;&lt;br&gt;Production + non-production on demand&lt;br&gt;3-month target; Senegal pilot candidate&lt;br&gt;Hybrid/internal cloud + restricted sites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f3;strokeColor=#c74634;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="scale" value="&lt;b&gt;Scale &amp; retention&lt;/b&gt;&lt;br&gt;&lt;br&gt;40–100/120 apps per entity&lt;br&gt;40–100 physical; 300–2,000 VMs&lt;br&gt;2 TB/day indicative; 6–12 months retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#1b6ac9;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="150" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dr" value="&lt;b&gt;HA / DR&lt;/b&gt;&lt;br&gt;&lt;br&gt;HA mandatory&lt;br&gt;RTO 4 hours; RPO 5–15 minutes&lt;br&gt;25–100 km site separation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#a56a00;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="150" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;Identity &amp; residency&lt;/b&gt;&lt;br&gt;&lt;br&gt;AD / Azure SSO + MFA + audit export&lt;br&gt;OPCO owns data; Group access&lt;br&gt;PII local or masked before transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#6c3baa;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="150" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="sn" value="&lt;b&gt;ServiceNow&lt;/b&gt;&lt;br&gt;&lt;br&gt;One Group Zurich instance&lt;br&gt;ITSM active; ITAM roadmap&lt;br&gt;Native UA adapter/API; no OIC&lt;br&gt;50–300 tickets/day/OPCO indicative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f7f0;strokeColor=#1b8753;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="containers" value="&lt;b&gt;Apps &amp; containers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Java / .NET / PHP; four DB families&lt;br&gt;OKE + VKS/Tanzu + EKS + OpenShift&lt;br&gt;OTel tracing expected; exact pods/nodes open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fc;strokeColor=#1b6ac9;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="430" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="opco" value="&lt;b&gt;Confirmed OPCO examples&lt;/b&gt;&lt;br&gt;&lt;br&gt;Madagascar: Ericsson, large multivendor estate&lt;br&gt;Comoros: Huawei-centric smaller estate&lt;br&gt;Preserve tools; validate APIs, versions and access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f3;strokeColor=#c74634;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="430" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="auto" value="&lt;b&gt;Autonomy boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Zero-touch Dark NOC is a phased target&lt;br&gt;LoganAI is not the agent&lt;br&gt;Dedicated OCI GenAI agent + measured safety case&lt;br&gt;Bounded, reversible, audited actions only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1d6;strokeColor=#a56a00;strokeWidth=2;fontColor=#312d2a;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="430" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="Commercial and production gate: clarify 2 TB/day scope; measure peak/average rates and cardinality; close blank inventory fields; validate vendor adapters, Management Packs, country residency, ServiceNow workflow, recovery drills and agent precision/recall before contractual commitment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3f0;strokeColor=#c74634;strokeWidth=2;fontColor=#312d2a;fontSize=16;align=left;verticalAlign=top;spacing=12;fontStyle=1;" vertex="1" parent="1">
