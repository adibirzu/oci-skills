{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracle.example/oci-visual-summary/summary-spec.schema.json",
  "title": "OCI Visual Summary specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "title", "takeaway", "audience", "purpose", "domain",
    "evidence_class", "archetype", "visual_direction", "anchors", "sources",
    "privacy", "outputs", "accessibility"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "takeaway": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "enum": ["iam", "networking", "storage", "security", "observability", "database", "ai", "analytics", "multicloud", "mixed", "project"]},
    "evidence_class": {"$ref": "#/$defs/evidence_class"},
    "archetype": {"type": "string", "enum": ["journey", "lifecycle", "hub-spoke", "control-map", "lessons", "layered-system", "before-after"]},
    "visual_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "dominant_path", "mascot_mode"],
      "properties": {
        "concept": {"const": "sketchnote-story-map-v1"},
        "dominant_path": {"type": "string", "minLength": 1},
        "mascot_mode": {"type": "string", "minLength": 1},
        "mascot_asset": {"type": "string", "minLength": 1},
        "domain_metaphor": {"type": "string"},
        "accent_roles": {"type": "array", "items": {"type": "string"}},
        "artwork_slots": {"type": "array", "items": {"type": "string"}},
        "doodle_density": {"type": "string", "enum": ["calm", "balanced", "lively"]},
        "stroke_style": {"type": "string", "enum": ["marker", "pencil", "chalk", "riso"]},
        "style_variant": {"type": "string", "enum": ["editorial", "doodle-at-a-glance", "project-capabilities", "canvas-story-map"]},
        "editable_targets": {"type": "array", "items": {"type": "string", "enum": ["svg", "drawio", "excalidraw", "pptx", "docx"]}},
        "style_preset": {"type": "string", "minLength": 1},
        "doodle_level": {"type": "string", "enum": ["minimal", "balanced", "rich"]}
      }
    },
    "artwork": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "generation_policy"],
      "properties": {
        "mode": {"type": "string", "enum": ["none", "doodle", "generated", "hybrid"]},
        "generation_policy": {"type": "string", "enum": ["none", "active-llm", "supplied-only"]},
        "style_register": {"type": "string", "enum": ["editorial", "explainer", "character", "cutout"]},
        "slots": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "anchor_id", "role", "alt_text"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,79}$"},
              "anchor_id": {"type": "string", "pattern": "^anchor-[1-8]$"},
              "role": {"type": "string", "enum": ["scene", "mascot", "doodle", "texture"]},
              "alt_text": {"type": "string", "minLength": 1, "maxLength": 240},
              "prompt_hint": {"type": "string", "maxLength": 240}
            }
          }
        }
      }
    },
    "anchors": {
      "type": "array", "minItems": 4, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "detail", "evidence_class", "source_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "evidence_class": {"$ref": "#/$defs/evidence_class"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "services": {"type": "array", "items": {"type": "string"}},
          "relationship": {"type": "string"},
          "scene_hint": {"type": "string", "maxLength": 160},
          "scene_role": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    },
    "flow": {"type": "object"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "claim_ids", "accessed", "classification"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "local_source": {"type": "string"},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "accessed": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "enum": ["public", "internal", "private", "customer-confidential"]}
        },
        "anyOf": [{"required": ["url"]}, {"required": ["local_source"]}]
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "public_eligible"],
      "properties": {
        "classification": {"type": "string", "enum": ["public", "internal", "private", "customer-confidential"]},
        "redactions": {"type": "array", "items": {"type": "string"}},
        "public_eligible": {"type": "boolean"}
      }
    },
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["formats", "aspect_ratio"],
      "properties": {
        "formats": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["png", "svg", "pdf", "pptx", "docx", "drawio", "excalidraw", "handoff", "art-request"]}},
        "aspect_ratio": {"type": "string", "enum": ["16:9", "4:3", "1:1", "portrait"]},
        "insertion_destination": {"type": "string"},
        "placement": {"type": "string"}
      }
    },
    "accessibility": {
      "type": "object", "additionalProperties": false,
      "required": ["reading_order", "alt_text"],
      "properties": {
        "reading_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "alt_text": {"type": "string", "minLength": 1},
        "contrast_target": {"type": "string"},
        "long_description": {"type": "string"}
      }
    }
  },
  "$defs": {
    "evidence_class": {"type": "string", "enum": ["design", "code-backed", "configured", "locally-verified", "provider-verified", "release-accepted", "unverified", "unavailable"]}
  }
}
