{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oci-skills/application-workflow.schema.json",
  "schema_version": 1,
  "title": "Sanitized application workflow evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "tests",
    "review",
    "verification",
    "raw_content"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "classification": {"enum": ["public", "internal", "restricted"]},
    "journey": {"type": "string", "maxLength": 500},
    "reuse_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate", "decision", "reason"],
        "properties": {
          "candidate": {"type": "string"},
          "decision": {"enum": ["accept", "reject"]},
          "reason": {"type": "string"}
        }
      }
    },
    "tests": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "raw_content": {"const": false}
  }
}
