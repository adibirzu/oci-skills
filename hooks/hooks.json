{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'script=\"${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/guard_destructive.py\"; [ -f \"$script\" ] || exit 0; python3 \"$script\"'",
            "description": "Block destructive OCI CLI commands until preflighted and confirmed; fail open if the plugin root is unavailable."
          }
        ]
      }
    ]
  }
}
